import cv2

cap = cv2.VideoCapture(0)

if not cap.isOpened():
    print("ERRO: não foi possível abrir a câmera")
    exit()

while True:
    ret, frame = cap.read()

    if not ret:
        print("ERRO ao receber imagem da câmera")
        break

    cv2.imshow("Teste Camera", frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()